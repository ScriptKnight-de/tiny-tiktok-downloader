# Copy to .env (docker compose reads it automatically)

# Host user/group that should own downloaded files (run `id -u` / `id -g`)
# Your TikTok username (without @); its liked and saved videos are downloaded
TIKTOK_USERNAME=

PUID=1000
PGID=1000

TZ=Europe/Berlin
# Daily sync time (local, HH:MM) and optional immediate sync at container start
TIKTOK_SYNC_TIME=04:00
TIKTOK_RUN_ON_START=true

# Alerts for failed syncs and expired/expiring login cookies (all optional, set any of them)
# TIKTOK_GOTIFY_URL=https://gotify.example.com
# TIKTOK_GOTIFY_TOKEN=
# TIKTOK_NTFY_URL=https://ntfy.sh/my-topic
# TIKTOK_NTFY_TOKEN=
# TIKTOK_WEBHOOK_URL=https://example.com/hook     # receives JSON: app, version, title, message, priority
# TIKTOK_COOKIE_WARN_DAYS=7                       # warn this many days before the login cookie expires

# Image to run (default: latest published image; set this to pin a version, e.g. :0.1.1)
# TINY_TIKTOK_DOWNLOADER_IMAGE=forgejo.scriptknight.de/scriptknight/tiny-tiktok-downloader:latest

# Host paths
# Folder that contains cookies.txt
TIKTOK_CONFIG_DIR=./config
TIKTOK_DATA_DIR=./data
TIKTOK_DOWNLOADS_DIR=./downloads

# --- Only for running without Docker (CLI / systemd timer) ---
# TIKTOK_COOKIES=~/.config/tiny-tiktok-downloader/cookies.txt
# TINY_TIKTOK_DOWNLOADER_OUTPUT_DIR=~/Pictures/tiny-tiktok-downloader
# TINY_TIKTOK_DOWNLOADER_ARCHIVE=~/.local/share/tiny-tiktok-downloader/archive.sqlite3
